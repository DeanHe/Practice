package main

func new21Game(n int, k int, maxPts int) float64 {
	if k == 0 || n >= k+maxPts {
		return 1
	}
	dp := make([]float64, n+1)
	dp[0] = 1.0
	pre_sum := 1.0
	res := 0.0
	for i := 1; i <= n; i++ {
		dp[i] = pre_sum / float64(maxPts)
		if i < k {
			pre_sum += dp[i]
		} else {
			res += dp[i]
		}
		if i-maxPts >= 0 {
			pre_sum -= dp[i-maxPts]
		}
	}
	return res
}
